    "raw_ads_discovered": {
      "type": "object",
      "properties": {
        "tool_call_made": {
          "type": "boolean",
          "const": true
        },
        "raw_ads_count": {
          "type": "integer",
          "minimum": -1,
          "description": "Nonnegative observed count in retrieved data, or -1 when unknown. Never a full-market estimate."
        },
        "distinct_advertisers_count": {
          "type": "integer",
          "minimum": -1,
          "description": "Nonnegative observed count in retrieved data, or -1 when unknown. Never a full-market estimate."
        },
        "notable_raw_patterns": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "snippets": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 1
        }
      },
      "required": [
        "tool_call_made",
        "raw_ads_count",
        "distinct_advertisers_count",
        "notable_raw_patterns",
        "snippets",
        "limitations"
      ],
      "additionalProperties": false
    },
    "exclusion_filtering": {
      "type": "object",
      "properties": {
        "exclusion_terms_provided": {
          "type": "boolean"
        },
        "filtering_possible": {
          "type": "boolean"
        },
        "excluded_ads_count": {
          "type": "integer",
          "minimum": -1,
          "description": "Nonnegative observed count in retrieved data, or -1 when unknown. Never a full-market estimate."
        },
        "in_scope_ads_count": {
          "type": "integer",
          "minimum": -1,
          "description": "Nonnegative observed count in retrieved data, or -1 when unknown. Never a full-market estimate."
        },
        "top_matched_exclusion_terms": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "uniqueItems": true
        },
        "scope_note": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "exclusion_terms_provided",
        "filtering_possible",
        "excluded_ads_count",
        "in_scope_ads_count",
        "top_matched_exclusion_terms",
        "scope_note"
      ],
      "additionalProperties": false
    },
    "competition_signal": {
      "type": "object",
      "properties": {
        "rating0_to10": {
          "type": "integer",
          "minimum": -1,
          "maximum": 10,
          "description": "Qualitative integer score from 0 to 10, or -1 for unknown."
        },
        "evidence_signals": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "inference": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "confidence0_to10": {
          "type": "integer",
          "minimum": -1,
          "maximum": 10,
          "description": "Qualitative integer score from 0 to 10, or -1 for unknown."
        },
        "justification": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "operational_definition": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
