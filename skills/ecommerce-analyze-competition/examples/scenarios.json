{
  "notice": "Synthetic build-time policy fixtures. No paid searches or real ad data. Scoring remains an agent judgment, not implemented by these fixture checks.",
  "scenarios": [
    {
      "id": "fixed-request",
      "kind": "request",
      "input": {
        "query": "pet hair removal glove",
        "country": "AUS",
        "category_name": "Pet hair removal accessories",
        "notes": [
          "Glove or mitt offers only; do not include rollers or vacuum products."
        ],
        "avoid_or_exclusion_terms": [
          "vacuum",
          "roller",
          "lint roller"
        ],
        "product_interpretations": [
          {
            "interpreted_product_type": "wearable hair-removal glove",
            "interpreted_archetype": "glove for removing pet hair",
            "why_this_interpretation": [
              "The supplied query specifies a glove."
            ],
            "confidence": "High"
          }
        ]
      },
      "run_date": "2026-11-04",
      "expected_request": {
        "query": "pet hair removal glove",
        "country": "AU",
        "start_date": "2026-08-04",
        "sort_by": "total_impressions",
        "search_type": "keyword_exact_phrase",
        "ad_type": "all",
        "status": "ACTIVE",
        "media_type": "ALL"
      },
      "expectation": "Exactly the eight approved fields; uppercase AU and no cursor on first call."
    },
