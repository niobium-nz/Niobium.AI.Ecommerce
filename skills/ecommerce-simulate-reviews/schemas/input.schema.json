{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ecommerce Simulate Reviews input",
  "description": "One selected customer segment and approved product context. No review-count override or external-research input. Structural validity does not establish factual sufficiency.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "target_country",
    "product_details",
    "customer_segment"
  ],
  "properties": {
    "target_country": {
      "$ref": "#/$defs/country_code"
    },
    "product_details": {
      "$ref": "#/$defs/product_details"
    },
    "customer_segment": {
      "$ref": "#/$defs/customer_segment"
    }
  },
  "$defs": {
    "product_details": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "working_product_definition": {
          "type": "string",
          "default": ""
        },
        "core_problem_solved": {
          "type": "string",
          "default": ""
        },
        "primary_use_cases": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "materials_or_construction_summary": {
          "type": "string",
          "default": ""
        },
        "fulfillment_and_refund_assumptions": {
          "type": "string",
          "default": ""
        },
        "suggested_product_names": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "recommended_primary_product_name": {
          "type": "string",
          "default": ""
        },
        "recommended_primary_product_name_rationale": {
          "type": "string",
          "default": ""
        }
      }
    },
    "customer_segment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "segment_number": {
          "type": "integer"
        },
        "segment_name": {
          "type": "string",
          "default": ""
        },
        "shared_context_snapshot": {
          "$ref": "#/$defs/shared_context_snapshot"
        },
        "segment_rating": {
          "$ref": "#/$defs/segment_rating"
        },
        "segment_summary": {
          "$ref": "#/$defs/segment_summary"
        },
        "angle_and_trigger_matrix": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/angle_trigger"
          },
          "default": []
        },
        "segment_landing_page_adaptation": {
          "$ref": "#/$defs/segment_landing_page_adaptation"
        }
      }
    },
    "shared_context_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "recommended_product_name": {
          "type": "string",
          "default": ""
        },
        "core_offer_stack": {
          "type": "string",
          "default": ""
        },
        "key_price_points": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "shipping_reality": {
          "type": "string",
          "default": ""
        },
        "guarantee_or_refund_framing": {
          "type": "string",
          "default": ""
        },
        "landing_page_role_in_funnel": {
          "type": "string",
          "default": ""
        }
      }
    },
    "segment_rating": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "overall_priority_rating": {
          "type": "integer"
        },
        "profit_potential_rating": {
          "type": "integer"
        },
        "trigger_intensity_rating": {
          "type": "integer"
        },
        "creative_clarity_rating": {
          "type": "integer"
        },
        "funnel_fit_rating": {
          "type": "integer"
        },
        "rationale": {
          "type": "string",
          "default": ""
        }
      }
    },
    "segment_summary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "who_this_segment_is": {
          "type": "string",
          "default": ""
        },
        "need_state": {
          "type": "string",
          "default": ""
        },
        "purchase_moment_or_trigger_condition": {
          "type": "string",
          "default": ""
        },
        "emotional_driver": {
          "type": "string",
          "default": ""
        },
        "main_objections": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "economic_attractiveness": {
          "type": "string",
          "default": ""
        }
      }
    },
    "angle_trigger": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "angle_number": {
          "type": "integer"
        },
        "angle_name": {
          "type": "string",
          "default": ""
        },
        "trigger": {
          "type": "string",
          "default": ""
        },
        "suggested_product_names_for_this_angle": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "recommended_product_name_for_this_angle": {
          "type": "string",
          "default": ""
        },
        "recommended_product_name_for_this_angle_rationale": {
          "type": "string",
          "default": ""
        },
        "recommended_short_product_code": {
          "type": "string",
          "default": ""
        },
        "recommended_website_primary_color_for_this_angle": {
          "type": "string",
          "default": ""
        },
        "recommended_website_secondary_color_for_this_angle": {
          "type": "string",
          "default": ""
        },
        "recommended_website_accent_color_for_this_angle": {
          "type": "string",
          "default": ""
        },
        "recommended_website_color_theme_for_this_angle_rationale": {
          "type": "string",
          "default": ""
        },
        "core_promise": {
          "type": "string",
          "default": ""
        },
        "message_territory": {
          "type": "string",
          "default": ""
        },
        "why_this_angle_should_convert_on_meta": {
          "type": "string",
          "default": ""
        },
        "objections_to_pre_handle": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "proof_or_demo_assets_required": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "recommended_cta_or_roas_target": {
          "type": "string",
          "default": ""
        },
        "creative_handoffs": {
          "$ref": "#/$defs/creative_handoffs"
        }
      }
    },
    "creative_handoffs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "static_image_directions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "short_form_video_or_ugc_directions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "first_frame_or_thumb_stop_direction": {
          "type": "string",
          "default": ""
        },
        "copy_hook_territories": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "headline_territories": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "visual_proof_moments": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "continuity_notes_for_landing_page": {
          "type": "string",
          "default": ""
        }
      }
    },
    "segment_landing_page_adaptation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hero_direction": {
          "type": "string",
          "default": ""
        },
        "benefit_order": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "faq_emphasis": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "section_emphasis": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "mobile_ux_notes": {
          "type": "string",
          "default": ""
        },
        "asset_needs_specific_to_this_segment": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      }
    },
