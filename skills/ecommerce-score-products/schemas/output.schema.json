{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ecommerce Score Products output",
  "description": "A complete score with an optional partial-research error, or an error-only object without a score. Arithmetic consistency and evidence support require the semantic checklist.",
  "oneOf": [
    {
      "$ref": "#/$defs/score"
    },
    {
      "$ref": "#/$defs/error_only"
    }
  ],
  "$defs": {
    "score": {
      "type": "object",
      "properties": {
        "score_version": {
          "type": "string",
          "const": "Ecommerce-PaidSocial-v1"
        },
