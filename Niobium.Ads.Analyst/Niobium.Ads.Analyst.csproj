<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerfileContext>.</DockerfileContext>
    <NoWarn>OPENAI001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Agents\KeywordsPlanner.md" />
    <None Remove="AgentTools\dog-hair-removal.json" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Agents\ProductNormalizer.md" />
    <EmbeddedResource Include="Agents\CompetitionScout.md" />
    <EmbeddedResource Include="Agents\KeywordsPlanner.md" />
    <EmbeddedResource Include="Agents\ProductClusterer.md" />
    <EmbeddedResource Include="Agents\ProductProfiler.md" />
    <EmbeddedResource Include="AgentTools\dog-hair-removal.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Http.Abstractions" Version="2.3.9" />
    <PackageReference Include="Microsoft.AspNetCore.WebUtilities" Version="10.0.3" />
    <PackageReference Include="Microsoft.Agents.AI.OpenAI" Version="1.0.0-rc2" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.3.0" />
    <PackageReference Include="ModelContextProtocol" Version="1.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.3.0" />
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Niobium.Ads.Contracts\Niobium.Ads.Contracts.csproj" />
  </ItemGroup>

</Project>
