    {
      "id": "unknown-price-currency",
      "kind": "manual",
      "given": {
        "visible": "$24 without currency context"
      },
      "expected": "Price may be 24 only if it is the actual primary price; currency remains null and a blocker records ambiguity."
    },
    {
      "id": "collection-ambiguity",
      "kind": "manual",
      "given": {
        "page": "Unrelated mug, lamp and shoes with equal prominence"
      },
      "expected": "Keep vendor evidence, set product null, request a product-specific URL in error."
    },
    {
      "id": "bundle-is-single-offer",
      "kind": "manual",
      "given": {
        "page": "Explicit mug-and-brush kit with one named offer"
      },
      "expected": "Profile the stated kit without inventing separate primary products."
    },
    {
      "id": "claims-not-verified",
      "kind": "manual",
      "given": {
        "visible": "Clinically proven and patented"
      },
      "expected": "Extract as merchant claims, not independent legal, clinical or patent verification."
    },
    {
      "id": "cleanup-fails",
      "kind": "manual",
      "given": {
        "close_verified": false
      },
      "expected": "Preserve evidence, add cleanup blocker and error; do not claim the tab closed."
    },
    {
      "id": "media-url-captured-not-fetched",
      "kind": "manual",
      "given": {
        "image": "https://cdn.example.net/photo.jpg"
