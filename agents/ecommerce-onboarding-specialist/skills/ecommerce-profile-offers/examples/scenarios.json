    {
      "id": "name-filled",
      "kind": "progress",
      "given": {
        "before": {
          "product": {}
        },
        "after": {
          "product": {
            "name": "Mug"
          }
        }
      },
      "expected": true
    },
    {
      "id": "image-not-progress",
      "kind": "progress",
      "given": {
        "before": {
          "product": {
            "name": "Mug"
          }
        },
        "after": {
          "product": {
            "name": "Mug",
            "images": [
              "x"
            ]
          }
        }
      },
      "expected": false
    },
    {
      "id": "list-first-value",
      "kind": "progress",
      "given": {
        "before": {
          "product": {
            "how_it_wins": {
              "positioning": []
            }
          }
        },
        "after": {
          "product": {
            "how_it_wins": {
              "positioning": [
                "Premium"
              ]
            }
          }
        }
      },
      "expected": true
    },
    {
      "id": "extra-list-item-no-progress",
      "kind": "progress",
      "given": {
        "before": {
          "product": {
            "how_it_wins": {
              "positioning": [
                "Premium"
              ]
            }
          }
        },
        "after": {
          "product": {
            "how_it_wins": {
              "positioning": [
                "Premium",
                "Durable"
              ]
            }
          }
        }
      },
      "expected": false
    },
    {
      "id": "zero-price-known",
      "kind": "progress",
      "given": {
        "before": {
          "product": {
            "price": null
          }
        },
        "after": {
          "product": {
            "price": 0
          }
        }
      },
      "expected": true
    },
    {
      "id": "tracking-and-fragment",
      "kind": "canonical",
      "given": {
        "url": "HTTPS://SHOP.EXAMPLE.COM:443/p/mug/?utm_source=x&fbclid=123#buy"
      },
      "expected": "https://shop.example.com/p/mug"
    },
    {
      "id": "keep-evidenced-variant",
      "kind": "canonical",
      "given": {
        "url": "https://shop.example.com/p/mug?variant=Blue&utm_campaign=x",
        "essential": [
          "variant"
        ]
      },
      "expected": "https://shop.example.com/p/mug?variant=Blue"
    },
    {
      "id": "path-case-preserved",
      "kind": "canonical",
      "given": {
        "url": "http://shop.example.com:80/Products/Mug/"
      },
      "expected": "http://shop.example.com/Products/Mug"
    },
