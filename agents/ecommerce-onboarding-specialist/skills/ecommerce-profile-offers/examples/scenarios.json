        "screen": true
      },
      "expected": "allow"
    },
    {
      "id": "headless-js-not-equivalent",
      "kind": "browser",
      "given": {
        "real_headed": false,
        "control": true,
        "screen": true,
        "javascript": true
      },
      "expected": "error"
    },
    {
      "id": "static-html-not-equivalent",
      "kind": "browser",
