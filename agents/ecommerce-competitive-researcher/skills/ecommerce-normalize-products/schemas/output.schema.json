{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ecommerce Normalize Products response",
  "description": "One full normal-result object, including clarification statuses, or an error-only object.",
  "oneOf": [
    {
      "$ref": "#/$defs/result"
    },
    {
      "$ref": "#/$defs/error"
    }
  ],
  "$defs": {
    "result": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "ok",
            "needs_more_info",
            "ambiguous"
          ]
        },
        "product_name_given": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "category_name_provided": {
          "type": [
            "string",
            "null"
          ]
        },
        "known_features_provided": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "normalization": {
          "$ref": "#/$defs/normalization"
        },
        "competitive_set_definition": {
          "$ref": "#/$defs/competitive_set_definition"
        },
        "product_interpretations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/product_interpretation"
          },
          "maxItems": 3
        },
        "web_research": {
          "$ref": "#/$defs/web_research"
        },
        "keyword_plan": {
          "$ref": "#/$defs/keyword_plan"
        },
        "notes_for_downstream_agent": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      },
      "required": [
        "status",
        "product_name_given",
        "category_name_provided",
        "known_features_provided",
        "normalization",
        "competitive_set_definition",
        "product_interpretations",
        "web_research",
        "keyword_plan",
        "notes_for_downstream_agent"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "ok"
              }
            }
          },
          "then": {
            "properties": {
              "competitive_set_definition": {
                "properties": {
                  "archetype_phrase": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "form_factor": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "job_to_be_done": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "must_include_tokens": {
                    "minItems": 2
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "ambiguous"
              }
            }
          },
          "then": {
            "properties": {
              "product_interpretations": {
                "minItems": 2,
                "maxItems": 3
              },
              "notes_for_downstream_agent": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "needs_more_info"
              }
            }
          },
          "then": {
            "properties": {
              "notes_for_downstream_agent": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "web_research": {
                "properties": {
                  "used": {
                    "const": false
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "normalization": {
                "properties": {
                  "observed_from_web": {
                    "maxItems": 0
                  }
                }
              }
            }
          }
        }
      ]
    },
    "normalization": {
      "type": "object",
      "properties": {
        "brand_model_tokens": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "uniqueItems": true
        },
        "base_category_inferred": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "observed_from_input": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "observed_from_web": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "confidence0_to10": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        }
      },
      "required": [
        "brand_model_tokens",
        "base_category_inferred",
        "observed_from_input",
        "observed_from_web",
        "assumptions",
        "confidence0_to10"
      ],
      "additionalProperties": false
    },
    "competitive_set_definition": {
      "type": "object",
      "properties": {
        "archetype_phrase": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "archetype_explanation": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "form_factor": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "job_to_be_done": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "primary_target": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "qualifiers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "uniqueItems": true
        },
        "must_include_tokens": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "uniqueItems": true,
          "maxItems": 5
        },
        "near_miss_classes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "uniqueItems": true
        },
        "avoid_terms": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "archetype_phrase",
        "archetype_explanation",
        "form_factor",
        "job_to_be_done",
        "primary_target",
        "qualifiers",
        "must_include_tokens",
        "near_miss_classes",
        "avoid_terms"
      ],
      "additionalProperties": false
    },
    "product_interpretation": {
      "type": "object",
      "properties": {
        "interpreted_product_type": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "interpreted_archetype": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "why_this_interpretation": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "confidence": {
          "type": "string",
          "enum": [
            "High",
            "Medium",
            "Low"
          ]
        }
      },
      "required": [
        "interpreted_product_type",
        "interpreted_archetype",
        "why_this_interpretation",
        "confidence"
      ],
      "additionalProperties": false
    },
    "web_research": {
      "type": "object",
      "properties": {
        "used": {
          "type": "boolean"
        },
        "queries": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "key_takeaways": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "source_domains": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\s/:?#@]+(?:\\.[^\\s/:?#@]+)+$"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "used",
        "queries",
        "key_takeaways",
        "source_domains"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "used": {
                "const": false
              }
            }
          },
          "then": {
            "properties": {
              "queries": {
                "maxItems": 0
              },
              "key_takeaways": {
                "maxItems": 0
              },
              "source_domains": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "keyword_plan": {
      "type": "object",
      "properties": {
        "tier_a_archetype_terms": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "uniqueItems": true,
          "maxItems": 12
        },
        "tier_b_close_archetype_synonyms": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "uniqueItems": true,
          "maxItems": 10
        },
        "tier_c_brand_model_terms": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "uniqueItems": true,
          "maxItems": 8
        },
        "tier_d_broad_context_terms": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "uniqueItems": true,
          "maxItems": 6
        },
        "avoid_or_exclusion_terms": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "uniqueItems": true
        },
        "recommended_mcp_queries": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "uniqueItems": true,
          "maxItems": 36
        }
      },
      "required": [
        "tier_a_archetype_terms",
        "tier_b_close_archetype_synonyms",
        "tier_c_brand_model_terms",
        "tier_d_broad_context_terms",
        "avoid_or_exclusion_terms",
        "recommended_mcp_queries"
      ],
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "properties": {
        "error": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "error"
      ],
      "additionalProperties": false
    }
  }
}
