{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Discoverer signal handoff for competitive research",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["schema_version", "job_id", "inputs", "product", "ads", "provenance", "lifecycle_stage", "research_status", "profitability_status"],
    "properties": {
      "schema_version": {"const": "2.0.0"},
      "job_id": {"$ref": "#/$defs/uuid"},
      "inputs": {"$ref": "input.schema.json"},
      "product": {
        "allOf": [
          {"$ref": "../skills/ecommerce-cluster-ads/schemas/output.schema.json#/$defs/cluster"},
          {"properties": {"is_product": {"const": true}, "is_service": {"const": false}}}
        ]
      },
      "ads": {
        "type": "array", "minItems": 1,
        "items": {
          "type": "object", "required": ["ad_archive_id", "is_active"],
          "properties": {"ad_archive_id": {"$ref": "#/$defs/nonblank"}, "is_active": {"const": true}},
          "additionalProperties": true
        }
      },
      "provenance": {
        "type": "object", "additionalProperties": false,
        "required": ["run_started_at", "timezone", "cutoff_date", "source_country", "target_country", "search_attempts", "successful_pages", "stop_reason", "run_status", "search_exhaustive"],
        "properties": {
          "run_started_at": {"type": "string", "format": "date-time"},
          "timezone": {"$ref": "#/$defs/nonblank"},
          "cutoff_date": {"type": "string", "format": "date"},
          "source_country": {"type": "string", "pattern": "^[A-Z]{2}$"},
          "target_country": {"type": "string", "pattern": "^[A-Z]{2}$"},
          "search_attempts": {"type": "integer", "minimum": 1, "maximum": 3},
          "successful_pages": {"type": "integer", "minimum": 1, "maximum": 3},
          "stop_reason": {"$ref": "#/$defs/nonblank"},
          "run_status": {"enum": ["complete", "partial"]},
          "search_exhaustive": {"const": false}
        }
      },
      "lifecycle_stage": {"const": "signal"},
      "research_status": {"const": "pending_competitive_research"},
      "profitability_status": {"const": "unverified"}
    }
  },
  "$defs": {
    "uuid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "nonblank": {"type": "string", "minLength": 1, "pattern": "\\S"}
  },
  "description": "Signals only, awaiting competitive research; never council-ready candidates or approved listings. Also validate exact IDs/order, originals, eligibility, countries, unique clusters, same job/provenance, and pages <= attempts."
}
