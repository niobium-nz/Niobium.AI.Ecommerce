{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Discoverer deployment configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["discovery_folder_id", "timezone"],
  "properties": {
    "discovery_folder_id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9_-]+$", "not": {"const": "root"}},
    "timezone": {"type": "string", "minLength": 1, "pattern": "\\S"}
  },
  "description": "Validate the real folder by ID and timezone through IANA data; no name-based fallback."
}
